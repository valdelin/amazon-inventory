# Credenciais SP-API do vendedor. Copie para .env e preencha com seus valores.
# NAO commitar o arquivo .env (ja esta no .gitignore).

# Client ID LWA (app registrado em Seller Central > Integração > Suas aplicações)
LWA_APP_ID=amzn1.application-oa2-client.SUBSTITUA

# Client Secret LWA
LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.SUBSTITUA

# Refresh token do vendedor autorizado (gerado no fluxo de autorização OAuth)
SP_API_REFRESH_TOKEN=Atzr|SUBSTITUA

# Caminho do PEM com a chave privada EC do cadastro (apenas se usado)
# SP_API_PRIVATE_KEY=/caminho/para/sua/chave/privada.pem

# Marketplace padrao (default: BR)
SP_API_DEFAULT_MARKETPLACE=BR